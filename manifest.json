{
  "manifest_version": 3,
  "name": "B站 IP 属地",
  "short_name": "B站属地",
  "version": "0.4.1",
  "description": "在哔哩哔哩网页评论区与个人主页显示手机端提供的 IP 属地。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://app.bilibili.com/*",
    "https://passport.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "B站 IP 属地",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "comment-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://space.bilibili.com/*"
      ],
      "js": [
        "profile.js"
      ],
      "css": [
        "profile.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
